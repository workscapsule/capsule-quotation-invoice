generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF") // "ADMIN" | "STAFF"
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id          String      @id @default(cuid())
  customerId  String      @unique
  name        String
  phone       String
  altPhone    String?
  email       String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  gstin       String?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  projects        Project[]
  quotations      Quotation[]
  invoices        Invoice[]
  payments        Payment[]
  paymentReceipts PaymentReceipt[]
}

model Project {
  id                     String      @id @default(cuid())
  projectId              String      @unique
  customerId             String
  customer               Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name                   String
  location               String?
  projectType            String?     // e.g. Residential, Commercial, Villa, Apartment
  startDate              DateTime?
  expectedCompletionDate DateTime?
  status                 String      @default("NEW") // NEW, IN_PROGRESS, COMPLETED, ON_HOLD, CANCELLED
  notes                  String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  quotations             Quotation[]
  invoices               Invoice[]
  payments               Payment[]
  paymentReceipts        PaymentReceipt[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quotation {
  id                 String             @id @default(cuid())
  quotationNumber    String             @unique
  quotationDate      DateTime           @default(now())
  validUntil         DateTime
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId          String
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectLocation    String?
  customerPhone      String?
  customerEmail      String?
  customerAddress    String?
  customerGstin      String?
  taxMode            String             @default("CGST_SGST") // "CGST_SGST" | "IGST" | "EXEMPT"
  discountType       String             @default("NONE")      // "PERCENTAGE" | "FIXED" | "NONE"
  discountValue      Float              @default(0)
  gstRate            Float              @default(18)
  subtotal           Float              @default(0)
  discountAmount     Float              @default(0)
  taxableAmount      Float              @default(0)
  cgstAmount         Float              @default(0)
  sgstAmount         Float              @default(0)
  igstAmount         Float              @default(0)
  otherChargesAmount Float              @default(0)
  grandTotal         Float              @default(0)
  roundedGrandTotal  Float              @default(0)
  status             String             @default("DRAFT")     // DRAFT, SENT, PENDING, APPROVED, REJECTED, EXPIRED, CONVERTED
  convertedInvoiceId String?
  notes              String?
  termsAndConditions String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items              QuotationItem[]
  additionalCharges  AdditionalCharge[]
  paymentReceipts    PaymentReceipt[]
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  categoryId   String?
  categoryName String
  imageUrl     String?   // Product image URL or preset path
  type         String    // Free text, user entered
  description  String    // Free text, user entered
  quantity     Float
  unit         String    // Sq.ft, R.ft, Nos, etc.
  rate         Float     // Strictly user entered!
  amount       Float     // quantity * rate
  sortOrder    Int       @default(0)
}

model Invoice {
  id                 String             @id @default(cuid())
  invoiceNumber      String             @unique
  quotationId        String?
  invoiceDate        DateTime           @default(now())
  dueDate            DateTime
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId          String
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectLocation    String?
  customerPhone      String?
  customerEmail      String?
  customerAddress    String?
  customerGstin      String?
  taxMode            String             @default("CGST_SGST") // "CGST_SGST" | "IGST" | "EXEMPT"
  discountType       String             @default("NONE")      // "PERCENTAGE" | "FIXED" | "NONE"
  discountValue      Float              @default(0)
  gstRate            Float              @default(18)
  subtotal           Float              @default(0)
  discountAmount     Float              @default(0)
  taxableAmount      Float              @default(0)
  cgstAmount         Float              @default(0)
  sgstAmount         Float              @default(0)
  igstAmount         Float              @default(0)
  otherChargesAmount Float              @default(0)
  grandTotal         Float              @default(0)
  roundedGrandTotal  Float              @default(0)
  totalPaid          Float              @default(0)
  balanceDue         Float              @default(0)
  paymentStatus      String             @default("UNPAID")    // UNPAID, PARTIALLY_PAID, PAID, OVERDUE
  notes              String?
  termsAndConditions String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items              InvoiceItem[]
  additionalCharges  AdditionalCharge[]
  payments           Payment[]
  paymentReceipts    PaymentReceipt[]
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  categoryId   String?
  categoryName String
  imageUrl     String?  // Product image URL or preset path
  type         String   // Free text, user entered
  description  String   // Free text, user entered
  quantity     Float
  unit         String
  rate         Float    // Strictly user entered!
  amount       Float    // quantity * rate
  sortOrder    Int      @default(0)
}

model Payment {
  id              String   @id @default(cuid())
  paymentId       String   @unique
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  paymentDate     DateTime @default(now())
  amountPaid      Float
  paymentMethod   String   @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, UPI, CHEQUE, OTHER
  referenceNumber String?
  notes           String?
  recordedBy      String?
  createdAt       DateTime @default(now())
}

model AdditionalCharge {
  id          String     @id @default(cuid())
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Float
}

model PaymentReceipt {
  id                       String     @id @default(cuid())
  receiptNumber            String     @unique
  receiptDate              DateTime   @default(now())

  // Relations / References
  customerId               String?
  customer                 Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId                String?
  project                  Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quotationId              String?
  quotation                Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  invoiceId                String?
  invoice                  Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  // Document numbers as displayed / entered
  quotationNumber          String?
  invoiceNumber            String?

  // Customer details (immutable on receipt snapshot)
  customerName             String
  customerPhone            String
  customerAddress          String?

  // Project details
  projectName              String
  projectLocation          String?

  // Payment details
  amountReceived           Float
  amountInWords            String
  paymentDate              DateTime   @default(now())
  paymentMode              String     // Cash, UPI, Bank Transfer, Cheque, Other
  transactionId            String?    // Transaction ID / Reference Number
  paymentPurpose           String     // Advance Payment, Part Payment, Final Payment, Other
  remarks                  String?    // Description / Remarks

  // Payment Summary
  totalProjectAmount       Float
  previousPaymentsReceived Float      @default(0)
  currentPaymentReceived   Float
  totalPaymentsReceived    Float
  remainingBalance         Float

  // Signatures
  receivedBy               String?    @default("CAPSULE COMPANY")
  authorizedSignatory      String?    @default("For CAPSULE COMPANY")

  status                   String     @default("ISSUED") // ISSUED, CANCELLED
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
}

