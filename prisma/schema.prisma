  email               String   @default("workscapsule@gmail.com")
  website             String   @default("")
  gstin               String   @default("29ABCDE1234F1Z5")
  bankName            String   @default("IDFC FIRST")
  accountName         String   @default("Mr. Poornesh Bakila Babu")
  accountNumber       String   @default("10177698837")
  ifscCode            String   @default("IDFB0081101")
  swiftCode           String?  @default("IDFBINBBMUM")
