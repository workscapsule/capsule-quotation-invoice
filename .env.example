# Database (Supabase PostgreSQL pooler or direct connection)
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# App & Auth
JWT_SECRET="your-jwt-secret-key"
NEXT_PUBLIC_APP_NAME="CAPSULE COMPANY"

# Supabase API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
